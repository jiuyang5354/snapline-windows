<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Settings" Background="Transparent" BorderThickness="1" CornerRadius="24" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F2FFFFFF" Offset="0" /><GradientStop Color="#80FFFFFF" Offset="1" /></LinearGradientBrush></Border.BorderBrush>
  <Border.Resources>
    <SolidColorBrush x:Key="Ink" Color="#202B2D" />
    <SolidColorBrush x:Key="Muted" Color="#35464A" />
    <SolidColorBrush x:Key="Line" Color="#2236494D" />
    <SolidColorBrush x:Key="Tint" Color="#57F4FAF6" />
    <SolidColorBrush x:Key="Accent" Color="#294F68" />
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Padding" Value="17,0" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Grid x:Name="MetalLayer" IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource Surface}" />
    </Style>
    <Style x:Key="Bare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#415257" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Height" Value="41" />
      <Setter Property="Margin" Value="0,3,0,4" />
      <Setter Property="Padding" Value="13,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Grid x:Name="MetalLayer" IsHitTestVisible="False" />
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#192B31" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Toggle" TargetType="CheckBox">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="29" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid x:Name="MetalLayer" IsHitTestVisible="False" />
              <Ellipse x:Name="Thumb" Width="21" Height="21" Margin="3,0" HorizontalAlignment="Left" Stroke="#90EEF5F6" StrokeThickness="1">
                <Ellipse.Fill><RadialGradientBrush GradientOrigin=".27,.17"><GradientStop Color="White" Offset="0" /><GradientStop Color="#E1E9EB" Offset=".35" /><GradientStop Color="#AFBEC3" Offset=".69" /><GradientStop Color="#DCE5E7" Offset="1" /></RadialGradientBrush></Ellipse.Fill>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Accent}" /><Setter TargetName="InputBorder" Property="BorderThickness" Value="2" /></Trigger></ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="Height" Value="70" /></Style>
  </Border.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="56" />
      <RowDefinition Height="*" />
      <RowDefinition Height="68" />
    </Grid.RowDefinitions>
    <Grid x:Name="SettingsTitlebar" Margin="25,0,19,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Snapline" FontFamily="Segoe UI" FontWeight="SemiBold" />
        <TextBlock Text=" / 设置" Foreground="{DynamicResource Muted}" />
      </StackPanel>
      <Button x:Name="CloseSettings" HorizontalAlignment="Right" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Bare}" Width="30" Height="30" MinHeight="30" Padding="0" ToolTip="关闭设置" />
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="171" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#19ECF2EE" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <Grid>
            <StackPanel Margin="15,19,15,0">
              <RadioButton x:Name="NavGeneral" GroupName="Pages" IsChecked="True"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" Width="20" Margin="0,0,11,0" /><TextBlock Text="常规" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavCapture" GroupName="Pages"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets" Width="20" Margin="0,0,11,0" /><TextBlock Text="截图" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavKeys" GroupName="Pages"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" Width="20" Margin="0,0,11,0" /><TextBlock Text="快捷键" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavStorage" GroupName="Pages"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" Width="20" Margin="0,0,11,0" /><TextBlock Text="存储" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavAbout" GroupName="Pages"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Width="20" Margin="0,0,11,0" /><TextBlock Text="关于" /></StackPanel></RadioButton>
            </StackPanel>
            <StackPanel VerticalAlignment="Bottom" Margin="24,0,0,22">
              <TextBlock Text="SNAPLINE" FontFamily="Consolas" FontSize="10" Foreground="{DynamicResource Muted}" />
              <TextBlock Text="Windows" Style="{StaticResource Quiet}" Margin="0,5,0,0" x:Name="VersionLabel" />
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="34,25,34,22">
        <Grid x:Name="Pages">
          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="常规" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="让截图随手可用，也让收集保持可控。" Style="{StaticResource Quiet}" Margin="0,8,0,18" />
            <TextBlock Text="自动收集" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="收集剪贴板图片" />
                <TextBlock Text="截图复制后，自动挂到顶部。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="CollectToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="收集剪贴板图片" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="暂停所有自动收集" />
                <TextBlock Text="剪贴板和截图文件夹一起暂停；仍可手动挂入。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="PauseToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="暂停所有自动收集" />
            </Grid>
            <TextBlock Text="应用行为" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,2" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="开机启动" />
                <TextBlock Text="登录 Windows 后启动 Snapline，默认关闭。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="开机启动" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="自动检查更新" />
                <TextBlock Text="包含预发布版本；下载后由你手动安装。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="UpdateToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="自动检查更新" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="CapturePage" Visibility="Collapsed">
            <TextBlock Text="截图" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="按区域截图快捷键，或从截图栏、托盘截图；拖动框选。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="截图包含鼠标指针" />
                <TextBlock Text="仅用于 Snapline 的区域截图，默认关闭。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="CursorToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="截图包含鼠标指针" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <TextBlock Text="开启后" FontWeight="SemiBold" Margin="0,22,0,0" />
            <TextBlock Text="框选区域后，把鼠标放到要展示的位置，再按 Enter。&#10;按 Esc 取消；拖动可以重新选择区域。" Style="{StaticResource Quiet}" Margin="0,9,0,0" LineHeight="24" />
            <TextBlock Text="截图保存到收件夹并复制，暂停自动收集时也可手动截图。&#10;Win + Shift + S 仍由 Windows 截图工具控制。" Style="{StaticResource Quiet}" Margin="0,24,0,0" LineHeight="24" />
          </StackPanel>
          <StackPanel x:Name="KeysPage" Visibility="Collapsed">
            <TextBlock Text="快捷键" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="点击对应输入框，再按下你想使用的按键。" Style="{StaticResource Quiet}" Margin="0,8,0,22" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="显示 / 隐藏截图栏" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="HotkeyInput" Grid.Column="1" Height="46" IsReadOnly="True" Text="Ctrl + Alt + T" FontFamily="Consolas" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Tint}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0" CaretBrush="Transparent" AutomationProperties.Name="录入显示隐藏快捷键" />
              <Button x:Name="RestoreKeys" Grid.Column="2" Content="恢复默认" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="区域截图" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="CaptureHotkeyInput" Grid.Column="1" Height="46" IsReadOnly="True" Text="Ctrl + Alt + S" FontFamily="Consolas" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Tint}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0" CaretBrush="Transparent" AutomationProperties.Name="录入区域截图快捷键" />
              <Button x:Name="RestoreCaptureKeys" Grid.Column="2" Content="恢复默认" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock x:Name="KeyHint" Text="支持单键和 Ctrl / Alt / Shift / Win 组合。" Foreground="{DynamicResource Muted}" Margin="0,14,0,14" TextWrapping="Wrap" LineHeight="20" MinHeight="40" />
            <Border Style="{StaticResource Rule}" />
            <TextBlock Text="悬停图片快捷操作" FontWeight="SemiBold" Margin="0,19,0,0" />
            <TextBlock Text="C 复制 · A 用画图编辑 · D / Delete 取下&#10;仅鼠标指向截图时生效，按住不会连续取下。" Style="{StaticResource Quiet}" Margin="0,8,0,0" LineHeight="22" />
          </StackPanel>
          <StackPanel x:Name="StoragePage" Visibility="Collapsed">
            <TextBlock Text="存储" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="图片保存在本地，取下卡片会保留原文件。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="截图收件夹" FontWeight="SemiBold" /><TextBlock Text="%LOCALAPPDATA%\Snapline\Inbox" FontFamily="Consolas" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" MaxWidth="385" HorizontalAlignment="Left" x:Name="InboxPath" TextTrimming="CharacterEllipsis" /></StackPanel>
              <Button x:Name="OpenInbox" Content="打开收件夹" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="自动收集文件夹" FontWeight="SemiBold" /><TextBlock Text="Windows 图片 / Screenshots" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" x:Name="WatchPath" MaxWidth="385" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" /></StackPanel>
              <Button x:Name="ChooseFolder" Content="选择文件夹" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="最多保留 12 张截图记录" /><TextBlock Text="只取下顶部卡片，保留收件夹内的图片。" Style="{StaticResource Quiet}" Margin="0,7,0,0" /></StackPanel>
              <Button x:Name="RemoveAll" Content="全部取下" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <TextBlock Text="关于 Snapline" FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="把截图挂起来，下一步随手取用。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid>
              <StackPanel>
                <TextBlock Text="Windows 版" FontWeight="SemiBold" />
                <TextBlock Text="" Style="{StaticResource Quiet}" Margin="0,8,0,0" x:Name="AboutVersion" />
              </StackPanel>
              <Button x:Name="CheckUpdates" Content="检查更新" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Rule}" Margin="0,24,0,20" />
            <TextBlock Text="来源与作者" FontWeight="SemiBold" />
            <TextBlock Text="原项目：Tendedero&#10;原作者：Alejandro Buján&#10;Windows 移植与发布：jiuyang5354" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" LineHeight="26" />
            <TextBlock Text="非官方 Windows 移植。保留 MIT 许可与原作者声明，&#10;使用独立的 Snapline 名称和图标。" Style="{StaticResource Quiet}" Margin="0,15,0,0" LineHeight="22" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="ViewAnnouncement" Content="更新公告" Margin="0,0,8,0" />
              <Button x:Name="ReleasePage" Content="版本发布页" Margin="0,0,8,0" />
              <Button x:Name="Usage" Content="使用说明" />
            </StackPanel>
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="25,0,25,0">
      <TextBlock x:Name="SettingsFeedback" Text="设置保存后生效" Style="{StaticResource Quiet}" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="600" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CancelSettings" Content="取消" Width="85" Height="38" Margin="0,0,10,0" IsCancel="True" />
        <Button x:Name="SaveSettings" Content="保存" Style="{StaticResource Primary}" Width="85" Height="38" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Border>
    
