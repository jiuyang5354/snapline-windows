<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Settings" Background="{DynamicResource Paper}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" TextElement.FontFamily="Microsoft YaHei UI" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True">

  <Border.Resources>
  <SolidColorBrush x:Key="Paper" Color="#FAFAF7" />
  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Sidebar" Color="#F2F2EE" />
  <SolidColorBrush x:Key="Tint" Color="#EEEFEA" />
  <SolidColorBrush x:Key="Ink" Color="#262B28" />
  <SolidColorBrush x:Key="Muted" Color="#70766F" />
  <SolidColorBrush x:Key="Line" Color="#E2E4DD" />
  <SolidColorBrush x:Key="Accent" Color="#C74F2D" />
  <SolidColorBrush x:Key="Track" Color="#CDD1C9" />
  <SolidColorBrush x:Key="NavSelected" Color="#E5E8DF" />
  <SolidColorBrush x:Key="PrimaryFill" Color="#2A302B" />
  <SolidColorBrush x:Key="PrimaryText" Color="#FFFFFF" />
  <Style x:Key="Quiet" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="FontSize" Value="12" /></Style>
  <Style x:Key="Rule" TargetType="Border"><Setter Property="Height" Value="1" /><Setter Property="Background" Value="{DynamicResource Line}" /></Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource Surface}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI" /><Setter Property="FontSize" Value="12" /><Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="13,0" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" RenderTransformOrigin=".5,.5">
        <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
        <Grid><Border x:Name="HoverWash" Background="{DynamicResource Ink}" Opacity="0" CornerRadius="5" IsHitTestVisible="False" />
          <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value=".4" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource PrimaryFill}" /><Setter Property="BorderBrush" Value="{DynamicResource PrimaryFill}" />
    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" /><Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Bare" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource Muted}" /><Setter Property="Height" Value="40" /><Setter Property="Margin" Value="0,2,0,2" />
    <Setter Property="Padding" Value="13,0" /><Setter Property="FontSize" Value="13" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Nav" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6">
        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource Tint}" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Nav" Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModeRadio" TargetType="RadioButton">
    <Setter Property="Height" Value="29" /><Setter Property="Width" Value="50" /><Setter Property="FontSize" Value="11" /><Setter Property="Margin" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Muted}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Mode" Background="Transparent" CornerRadius="4" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Mode" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Toggle" TargetType="CheckBox">
    <Setter Property="Width" Value="44" /><Setter Property="Height" Value="28" /><Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="14" Padding="2">
        <Border x:Name="Track" Background="{DynamicResource Track}" CornerRadius="11"><Ellipse x:Name="Thumb" Width="16" Height="16" Margin="3,0" Fill="White" HorizontalAlignment="Left"><Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform></Ellipse></Border>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value=".8" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Ring" Property="Opacity" Value=".4" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" /><Setter Property="Background" Value="{DynamicResource Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Input" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Input" Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingRow" TargetType="Grid"><Setter Property="Height" Value="76" /></Style>
</Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="48" />
      <RowDefinition Height="*" />
      <RowDefinition Height="64" />
    </Grid.RowDefinitions>
    <Grid x:Name="SettingsTitlebar" Margin="25,0,19,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Snapline" FontFamily="Segoe UI" FontWeight="SemiBold" />
        <TextBlock Text=" / 设置" Foreground="{DynamicResource Muted}" />
      </StackPanel>
      <Button x:Name="CloseSettings" HorizontalAlignment="Right" Content="" FontFamily="Segoe MDL2 Assets" Style="{StaticResource Bare}" Width="28" Height="28" MinHeight="28" Padding="0" ToolTip="关闭设置" />
    </Grid>
    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="196" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid x:Name="NavigationTabs" Margin="14,22,14,0" VerticalAlignment="Top">
              <Border x:Name="NavSelection" Width="0" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource NavSelected}" CornerRadius="6" IsHitTestVisible="False">
                <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
                <Border Width="2" Height="14" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="1" />
              </Border>
            <StackPanel><TextBlock Text="偏好设置" FontSize="11" Foreground="{DynamicResource Muted}" Margin="13,0,0,12" />
              <RadioButton x:Name="NavGeneral" GroupName="Pages" IsChecked="True"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M3,5 L17,5 M3,15 L17,15 M7,2 L7,8 M13,12 L13,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="常规" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavCapture" GroupName="Pages"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M6,2 L2,2 L2,6 M14,2 L18,2 L18,6 M2,14 L2,18 L6,18 M18,14 L18,18 L14,18 M7,7 L13,7 L13,13 L7,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="截图" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavKeys" GroupName="Pages"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M3,5 L17,5 Q18,5 18,6 L18,14 Q18,15 17,15 L3,15 Q2,15 2,14 L2,6 Q2,5 3,5 Z M5,8 L6,8 M9,8 L10,8 M13,8 L15,8 M5,12 L7,12 M10,12 L15,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="快捷键" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavStorage" GroupName="Pages"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M2,6 L2,16 Q2,18 4,18 L16,18 Q18,18 18,16 L18,7 Q18,5 16,5 L10,5 L8,2 L4,2 Q2,2 2,4 L2,6 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="存储" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavShelf" GroupName="Pages"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M3,3 L17,3 L17,17 L3,17 Z M3,12 L7,12 L8,14 L12,14 L13,12 L17,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="暂存架" /></StackPanel></RadioButton>
              <RadioButton x:Name="NavAbout" GroupName="Pages"><StackPanel Orientation="Horizontal"><Viewbox Width="17" Height="17" Margin="0,0,12,0"><Path Width="20" Height="20" Data="M10,2 A8,8 0 1 1 9.99,2 M10,9 L10,14 M10,6 L10,6.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Viewbox><TextBlock Text="关于" /></StackPanel></RadioButton>
            </StackPanel>
            </Grid>
            <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,20">
  <TextBlock Text="外观" FontSize="11" Foreground="{DynamicResource Muted}" Margin="5,0,0,9" />
  <Border Background="{DynamicResource Tint}" CornerRadius="6" Padding="2"><Grid x:Name="ThemeTabs">
    <Border x:Name="ThemeSelection" Width="0" Height="29" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False"><Border.RenderTransform><TranslateTransform /></Border.RenderTransform></Border>
    <StackPanel Orientation="Horizontal">
    <RadioButton x:Name="ThemeLight" GroupName="Appearance" Content="浅色" Style="{StaticResource ModeRadio}" />
    <RadioButton x:Name="ThemeDark" GroupName="Appearance" Content="深色" Style="{StaticResource ModeRadio}" />
    <RadioButton x:Name="ThemeSystem" GroupName="Appearance" Content="系统" Style="{StaticResource ModeRadio}" />
  </StackPanel></Grid></Border>
  <TextBlock Text="Windows" Style="{StaticResource Quiet}" Margin="5,17,0,0" x:Name="VersionLabel" />
</StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="38,27,38,24">
        <Grid x:Name="Pages">
          <StackPanel x:Name="GeneralPage">
            <TextBlock Text="常规" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="设置截图的收集方式与应用行为。" Style="{StaticResource Quiet}" Margin="0,8,0,18" />
            <TextBlock Text="自动收集" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,2" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="收集剪贴板图片" />
                <TextBlock Text="截图复制后，自动挂到顶部。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="CollectToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="收集剪贴板图片" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="暂停所有自动收集" />
                <TextBlock Text="剪贴板和截图文件夹一起暂停；仍可手动挂入。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="PauseToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="暂停所有自动收集" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="收集新截图时自动展开" />
                <TextBlock Text="关闭后静默收集；顶部悬停、快捷键仍可展开。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="ShowOnCaptureToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="收集新截图时自动展开" />
            </Grid>
            <TextBlock Text="应用行为" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="0,14,0,2" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="开机启动" />
                <TextBlock Text="登录 Windows 后启动 Snapline，默认关闭。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="StartupToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="开机启动" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="自动检查更新" />
                <TextBlock Text="包含预发布版本；下载后由你手动安装。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="UpdateToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" IsChecked="True" AutomationProperties.Name="自动检查更新" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="CapturePage" Visibility="Collapsed">
            <TextBlock Text="截图" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="按区域截图快捷键，或从截图栏、托盘截图；拖动框选。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="截图包含鼠标指针" />
                <TextBlock Text="仅用于 Snapline 的区域截图，默认关闭。" Style="{StaticResource Quiet}" Margin="0,5,0,0" />
              </StackPanel>
              <CheckBox x:Name="CursorToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="截图包含鼠标指针" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="拖到未接收区域时取下" /><TextBlock Text="默认开启。取下保留原文件，Esc 取消保留卡片。" Style="{StaticResource Quiet}" Margin="0,5,0,0" /></StackPanel>
              <CheckBox x:Name="BlankDropToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="拖到未接收区域时取下" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <TextBlock Text="拖入聊天框或文件夹会复制，截图继续留在绳上。" Style="{StaticResource Quiet}" Margin="0,18,0,0" />
            <TextBlock Text="开启截图指针后" FontWeight="SemiBold" Margin="0,22,0,0" />
            <TextBlock Text="框选区域后，把鼠标放到要展示的位置，再按 Enter。&#10;按 Esc 取消；拖动可以重新选择区域。" Style="{StaticResource Quiet}" Margin="0,9,0,0" LineHeight="24" />
            <TextBlock Text="截图保存到收件夹并复制，暂停自动收集时也可手动截图。&#10;Win + Shift + S 仍由 Windows 截图工具控制。" Style="{StaticResource Quiet}" Margin="0,24,0,0" LineHeight="24" />
          </StackPanel>
          <StackPanel x:Name="KeysPage" Visibility="Collapsed">
            <TextBlock Text="快捷键" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="点击对应输入框，再按下你想使用的按键。" Style="{StaticResource Quiet}" Margin="0,8,0,22" />
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="显示 / 隐藏截图栏" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="HotkeyInput" Grid.Column="1" Height="46" IsReadOnly="True" Text="Ctrl + Alt + T" FontFamily="Consolas" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Tint}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0" CaretBrush="Transparent" AutomationProperties.Name="录入显示隐藏快捷键" />
              <Button x:Name="RestoreKeys" Grid.Column="2" Content="恢复默认" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="区域截图" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="CaptureHotkeyInput" Grid.Column="1" Height="46" IsReadOnly="True" Text="Ctrl + Alt + S" FontFamily="Consolas" FontSize="20" TextAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Tint}" Foreground="{DynamicResource Ink}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,0" CaretBrush="Transparent" AutomationProperties.Name="录入区域截图快捷键" />
              <Button x:Name="RestoreCaptureKeys" Grid.Column="2" Content="恢复默认" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <Grid Margin="0,16,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="128" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="清空截图栏" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBox x:Name="ClearHotkeyInput" Grid.Column="1" Height="46" IsReadOnly="True" FontFamily="Consolas" FontSize="16" TextAlignment="Center" VerticalContentAlignment="Center" Background="{DynamicResource Tint}" BorderBrush="{DynamicResource Line}" Padding="8,0" CaretBrush="Transparent" AutomationProperties.Name="录入清空截图栏快捷键" />
              <Button x:Name="RestoreClearKeys" Grid.Column="2" Content="恢复默认" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="清空只取下卡片，保留所有原文件。" Style="{StaticResource Quiet}" Margin="128,9,0,0" />
            <TextBlock x:Name="KeyHint" Text="支持单键和 Ctrl / Alt / Shift / Win 组合。" Foreground="{DynamicResource Muted}" Margin="0,14,0,14" TextWrapping="Wrap" LineHeight="20" MinHeight="40" />
            <Border Style="{StaticResource Rule}" />
            <TextBlock Text="悬停图片快捷操作" FontWeight="SemiBold" Margin="0,19,0,0" />
            <TextBlock Text="C 复制 · A 用画图编辑 · D / Delete 取下&#10;仅鼠标指向截图时生效，按住不会连续取下。" Style="{StaticResource Quiet}" Margin="0,8,0,0" LineHeight="22" />
          </StackPanel>
          <StackPanel x:Name="StoragePage" Visibility="Collapsed">
            <TextBlock Text="存储" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="管理截图的保存位置与自动收集来源。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="截图收件夹" FontWeight="SemiBold" /><TextBlock Text="%LOCALAPPDATA%\Snapline\Inbox" FontFamily="Consolas" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" MaxWidth="300" HorizontalAlignment="Left" x:Name="InboxPath" TextTrimming="CharacterEllipsis" /></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="ChooseInbox" Content="更改位置" Margin="0,0,12,0" />
                <Button x:Name="OpenInbox" Content="打开收件夹" />
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="自动收集文件夹" FontWeight="SemiBold" /><TextBlock Text="Windows 图片 / Screenshots" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" x:Name="WatchPath" MaxWidth="385" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" /></StackPanel>
              <Button x:Name="ChooseFolder" Content="选择文件夹" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Height="97">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="清空截图栏" /><TextBlock Text="取下全部卡片，保留所有原文件。快捷键可在左侧设置。" Style="{StaticResource Quiet}" Margin="0,7,0,0" /></StackPanel>
              <Button x:Name="RemoveAll" Content="全部取下" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </StackPanel>
          <StackPanel x:Name="ShelfPage" Visibility="Collapsed">
            <TextBlock Text="文件暂存架" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="先放在右侧，切换应用后再拖到目的地。" Style="{StaticResource Quiet}" Margin="0,8,0,18" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="启用文件暂存架" /><TextBlock Text="从桌面或资源管理器拖动文件时自动展开。" Style="{StaticResource Quiet}" Margin="0,5,0,0" /></StackPanel>
              <CheckBox x:Name="ShelfToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="启用文件暂存架" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="在任何应用中拖动时都展开" /><TextBlock Text="关闭时仍可用 Ctrl + Alt + D 或托盘打开。" Style="{StaticResource Quiet}" Margin="0,5,0,0" /></StackPanel>
              <CheckBox x:Name="ShelfAnyAppToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="在任何应用中拖动时都展开" />
            </Grid>
            <Border Style="{StaticResource Rule}" />
            <Grid Style="{StaticResource SettingRow}">
              <StackPanel VerticalAlignment="Center"><TextBlock Text="拖出后仍保留在暂存架" /><TextBlock Text="默认成功拖出后移出记录；取消拖动会保留。" Style="{StaticResource Quiet}" Margin="0,5,0,0" /></StackPanel>
              <CheckBox x:Name="ShelfKeepToggle" Style="{StaticResource Toggle}" HorizontalAlignment="Right" AutomationProperties.Name="拖出后仍保留在暂存架" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
              <Button x:Name="OpenShelf" Content="打开暂存架" Margin="0,0,8,0" />
              <Button x:Name="OpenClippings" Content="打开剪藏文件夹" Margin="0,0,8,0" />
              <Button x:Name="ClearShelf" Content="清空暂存架" />
            </StackPanel>
            <TextBlock Text="文件只记录路径，移出或清空不删除原文件。&#10;多文件可叠放、右键拆分；拖入文字、链接和图片会保存到剪藏文件夹。&#10;快捷键被占用时使用托盘入口。主屏右侧停靠；管理员窗口受系统拖放权限限制。" Style="{StaticResource Quiet}" Margin="0,18,0,0" LineHeight="22" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel x:Name="AboutPage" Visibility="Collapsed">
            <TextBlock Text="关于 Snapline" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="把截图挂起来，下一步随手取用。" Style="{StaticResource Quiet}" Margin="0,8,0,24" />
            <Grid>
              <StackPanel>
                <TextBlock Text="Windows 版" FontWeight="SemiBold" />
                <TextBlock Text="" Style="{StaticResource Quiet}" Margin="0,8,0,0" x:Name="AboutVersion" />
              </StackPanel>
              <Button x:Name="CheckUpdates" Content="检查更新" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource Rule}" Margin="0,24,0,20" />
            <TextBlock Text="来源与作者" FontWeight="SemiBold" />
            <TextBlock Text="原项目：Tendedero&#10;原作者：Alejandro Buján&#10;Windows 移植与发布：jiuyang5354" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" LineHeight="26" />
            <TextBlock Text="非官方 Windows 移植。保留 MIT 许可与原作者声明，&#10;使用独立的 Snapline 名称和图标。" Style="{StaticResource Quiet}" Margin="0,15,0,0" LineHeight="22" />
            <TextBlock Text="文件暂存架基于 jiuyang5354 的 Dropline（MIT）。&#10;Dropline 灵感来自 Yoink，未使用 Yoink 代码或素材，与其作者无关联。" Style="{StaticResource Quiet}" Margin="0,10,0,0" LineHeight="22" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="ViewAnnouncement" Content="更新公告" Margin="0,0,8,0" />
              <Button x:Name="ReleasePage" Content="版本发布页" Margin="0,0,8,0" />
              <Button x:Name="Usage" Content="使用说明" />
            </StackPanel>
          </StackPanel>
        </Grid>
        </ScrollViewer>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="25,0,25,0">
      <TextBlock x:Name="SettingsFeedback" Text="设置保存后生效" Style="{StaticResource Quiet}" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="600" TextTrimming="CharacterEllipsis" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="CancelSettings" Content="取消" Width="85" Height="38" Margin="0,0,10,0" IsCancel="True" />
        <Button x:Name="SaveSettings" Content="保存更改" Style="{StaticResource Primary}" Width="96" Height="38" IsDefault="True" />
      </StackPanel>
    </Grid>
  </Grid>
</Border>
    
