<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ToolButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Tool.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Tool.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Tool.Hover}" /></Trigger>
            <MultiTrigger><MultiTrigger.Conditions><Condition Property="Tag" Value="primary" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Tool.PrimaryHover}" /></MultiTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.74" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToolPrimary" TargetType="Button" BasedOn="{StaticResource ToolButton}">
    <Setter Property="Tag" Value="primary" />
    <Setter Property="Background" Value="{DynamicResource Tool.PrimaryFill}" />
    <Setter Property="Foreground" Value="{DynamicResource Tool.PrimaryText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Tool.PrimaryFill}" />
    <Setter Property="Padding" Value="20,11" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tool.PrimaryHover}" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ToolInput" TargetType="TextBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Tool.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Tool.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CaretBrush" Value="{DynamicResource Tool.Ink}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Tool.Accent}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" CornerRadius="7" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToolPassword" TargetType="PasswordBox">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Tool.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Tool.Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="PasswordBox">
        <Border x:Name="Chrome" CornerRadius="7" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" Background="{TemplateBinding Background}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolCombo" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Tool.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Tool.Line}" />
    <Setter Property="Padding" Value="11,10" />
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="11,9" /><Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" /><Setter Property="Background" Value="{DynamicResource Tool.Surface}" /><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource Tool.Hover}" /></Trigger></Style.Triggers></Style></Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ComboBox">
        <Grid>
          <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="7" Background="{DynamicResource Tool.Surface}" BorderBrush="{DynamicResource Tool.Line}" BorderThickness="1"><Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Tool.Muted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" /></Border></ControlTemplate></ToggleButton.Template>
          </ToggleButton>
          <ContentPresenter IsHitTestVisible="False" Margin="11,10,30,10" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
          <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom" Focusable="False" PopupAnimation="None">
            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="310" Margin="0,4,0,0" CornerRadius="8" Padding="4" Background="{DynamicResource Tool.Surface}" BorderBrush="{DynamicResource Tool.Line}" BorderThickness="1"><ScrollViewer><ItemsPresenter /></ScrollViewer></Border>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolCheck" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="CheckBox">
        <Border x:Name="Box" Width="17" Height="17" CornerRadius="4" Background="{DynamicResource Tool.Surface}" BorderThickness="1" BorderBrush="{DynamicResource Tool.Line}">
          <Path x:Name="Tick" Data="M3,7 L6,10 L12,3" Stroke="White" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Hidden" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Tool.Accent}" /><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /><Setter TargetName="Tick" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Tool.Ink}" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolSlider" TargetType="Slider">
    <Setter Property="Height" Value="25" /><Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid>
      <Border Height="3" Background="{DynamicResource Tool.Line}" CornerRadius="2" VerticalAlignment="Center" />
      <Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" Background="{DynamicResource Tool.Accent}" CornerRadius="2" VerticalAlignment="Center" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{DynamicResource Tool.Surface}" Stroke="{DynamicResource Tool.Accent}" StrokeThickness="2" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolNav" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Tool.Muted}" /><Setter Property="FontSize" Value="12" /><Setter Property="Padding" Value="12,10" /><Setter Property="Margin" Value="0,2" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
      <Border x:Name="Nav" CornerRadius="7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter Margin="{TemplateBinding Padding}" /></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Nav" Property="Background" Value="{DynamicResource Tool.Hover}" /></Trigger>
        <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource Tool.Accent}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Nav" Property="BorderBrush" Value="{DynamicResource Tool.Accent}" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolRow" TargetType="DataGridRow">
    <Setter Property="MinHeight" Value="61" /><Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" /><Setter Property="Background" Value="{DynamicResource Tool.Surface}" /><Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource Tool.Line}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="ToolTip" Value="{Binding FullPath}" />
    <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Tool.Hover}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource Tool.Active}" /></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="ToolCell" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource Tool.Ink}" /><Setter Property="Background" Value="Transparent" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Padding" Value="0" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="Transparent"><ContentPresenter VerticalAlignment="Center" Margin="3,0" /></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ToolColumn" TargetType="DataGridColumnHeader">
    <Setter Property="Height" Value="35" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource Tool.Muted}" /><Setter Property="Background" Value="{DynamicResource Tool.SurfaceSoft}" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="4,0" />
  </Style>
</ResourceDictionary>
